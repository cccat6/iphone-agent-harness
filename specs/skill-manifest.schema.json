{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declarative browser skill package v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "entry": {
      "const": "SKILL.md"
    },
    "protocolVersion": {
      "const": 1
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]+$"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "families": {
      "type": "array",
      "items": {
        "enum": [
          "checkbox",
          "text",
          "image-selection",
          "slider",
          "rotation-order",
          "temporal"
        ]
      },
      "minItems": 0,
      "maxItems": 6
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "entry",
    "protocolVersion",
    "requiredCapabilities",
    "families",
    "files"
  ]
}
