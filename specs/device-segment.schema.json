{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESP32 input segment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "enum": [
        1,
        2
      ]
    },
    "boardId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "bootId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "leaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "segmentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "segmentIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 29
    },
    "ttlMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 15000
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "kind": {
                "const": "pointer"
              },
              "buttons": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "atMs",
              "kind",
              "buttons",
              "x",
              "y"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "kind": {
                "const": "keyboard"
              },
              "modifiers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "usages": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 231
                },
                "maxItems": 6,
                "uniqueItems": true
              }
            },
            "required": [
              "atMs",
              "kind",
              "modifiers",
              "usages"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "kind": {
                "const": "consumer"
              },
              "usage": {
                "enum": [
                  0,
                  64
                ]
              }
            },
            "required": [
              "atMs",
              "kind",
              "usage"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 512
    },
    "gesture": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "home"
            }
          ],
          "minItems": 1,
          "maxItems": 1,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "tap"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 500
            },
            {
              "type": "integer",
              "minimum": 40,
              "maximum": 1200
            }
          ],
          "minItems": 5,
          "maxItems": 5,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "key"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 4,
              "maximum": 231
            },
            {
              "type": "integer",
              "minimum": 40,
              "maximum": 1200
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "path"
            },
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 500
            },
            {
              "type": "integer",
              "minimum": 8,
              "maximum": 100
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3000
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3000
                  }
                ],
                "minItems": 3,
                "maxItems": 3,
                "items": false
              }
            }
          ],
          "minItems": 6,
          "maxItems": 6,
          "items": false
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "reports"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "oneOf": [
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      {
                        "const": 0
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10000
                      }
                    ],
                    "minItems": 5,
                    "maxItems": 5,
                    "items": false
                  },
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      {
                        "const": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "type": "integer",
                          "minimum": 4,
                          "maximum": 231
                        }
                      }
                    ],
                    "minItems": 4,
                    "maxItems": 4,
                    "items": false
                  },
                  {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5000
                      },
                      {
                        "const": 2
                      },
                      {
                        "enum": [
                          0,
                          64
                        ]
                      }
                    ],
                    "minItems": 3,
                    "maxItems": 3,
                    "items": false
                  }
                ]
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "boardId",
    "bootId",
    "targetId",
    "clientId",
    "leaseId",
    "segmentId",
    "planId",
    "segmentIndex",
    "ttlMs",
    "payloadHash"
  ],
  "oneOf": [
    {
      "properties": {
        "protocolVersion": {
          "const": 1
        }
      },
      "required": [
        "events"
      ],
      "not": {
        "required": [
          "gesture"
        ]
      }
    },
    {
      "properties": {
        "protocolVersion": {
          "const": 2
        }
      },
      "required": [
        "gesture"
      ],
      "not": {
        "required": [
          "events"
        ]
      }
    }
  ]
}
