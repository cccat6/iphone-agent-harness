{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "igent-openai-relay",
  "main": "apps/web/api/openai-relay-worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "placement": {
    "region": "aws:us-east-1"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://igent.cc"
  }
}
